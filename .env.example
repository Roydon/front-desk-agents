# Copy to .env and fill in. .env is gitignored.

# Provider: fake (offline demo, deterministic), openrouter, ollama, anthropic
LLM_PROVIDER=fake

# OpenRouter (hosted demo). Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Ollama (local)
OLLAMA_MODEL=llama3.1:8b

# Anthropic (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_TRIAGE_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_DRAFT_MODEL=claude-sonnet-5

# Cache LLM responses so eval re-runs / demos survive rate limits and outages
LLM_CACHE=1

# HTTP Basic Auth for the hosted demo. Leave BOTH blank to disable auth (local dev).
APP_USER=
APP_PASSWORD=

# Fixed demo clock
DEMO_TODAY=2026-08-24
TZ=America/New_York
